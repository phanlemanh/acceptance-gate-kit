+/**
+ * Nạp `.env` ở gốc kho bằng `process.loadEnvFile` (built-in từ Node 20.6; kho ở @types/node
+ * ^24.13.2) — KHÔNG thêm `dotenv`. Ba điều được giữ đúng ở đây:
+ *
+ *   1. Biến có sẵn trong `process.env` THẮNG giá trị trong file. Đó là hành vi của
+ *      `loadEnvFile`, và là hành vi phải có: CI, systemd, Docker `-e` đều bơm secret qua env
+ *      thật, một file `.env` lạc trong image không được phép ghi đè chúng.
+ *   2. Thiếu file thì im lặng đi tiếp — deployment thật KHÔNG dùng `.env`, nó dùng env thật.
+ *   3. Chỉ chạy trong `main()`, tức chỉ khi thực thi trực tiếp. Import từ test KHÔNG được
+ *      chạm đĩa hay mutate env toàn cục (cùng luật với `isMain` ở cuối file).
+ *
+ * File `.env` nằm ở GỐC KHO, không phải cạnh file này: nó phục vụ cả `npm run service:dev` lẫn
+ * `npm run demo`, và gốc kho là chỗ duy nhất cả hai đều thấy.
+ */
+function loadDotEnv(): void {
+  const envPath = resolve(import.meta.dirname, '../../.env')
+  if (existsSync(envPath)) process.loadEnvFile(envPath)
+}
 
