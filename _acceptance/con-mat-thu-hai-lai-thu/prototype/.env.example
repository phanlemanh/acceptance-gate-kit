# ─────────────────────────────────────────────────────────────────────────────
# FloorPlanStudio — biến môi trường
#
# Chép file này thành `.env` rồi điền. `.env` đã nằm trong .gitignore và
# KHÔNG BAO GIỜ được commit. `server.ts` tự nạp `.env` lúc khởi động
# (process.loadEnvFile) — biến có sẵn trong shell luôn THẮNG giá trị trong file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Bắt buộc ─────────────────────────────────────────────────────────────────
# Khoá HMAC ký request. TỐI THIỂU 32 ký tự — service TỪ CHỐI KHỞI ĐỘNG nếu thiếu
# hoặc ngắn hơn (MIN_HMAC_KEY_LENGTH, service/src/server.ts).
# Sinh khoá: openssl rand -hex 32
FLOORPLAN_HMAC_KEY=

# Cổng HTTP. Bỏ trống = 3300.
PORT=


# ── OpenRouter (VLM) — TUỲ CHỌN, dùng cho vòng «Người lạ lái thử» ─────────────
# Bỏ trống cả khối = năng lực TẮT, service chạy bình thường như trước.
# Điền khoá mà để sai một biến khác thì service NÉM lúc khởi động — cấu hình
# nửa vời nguy hiểm hơn không cấu hình.
#
# Lấy khoá: https://openrouter.ai/keys   (dạng sk-or-v1-…, 73 ký tự)
OPENROUTER_API_KEY=

# Model VLM. Bỏ trống = google/gemini-3.7-flash.
# Đối chiếu GET https://openrouter.ai/api/v1/models ngày 2026-08-20 — bốn ứng
# viên nhận ảnh, giá mỗi triệu token (vào/ra), ngữ cảnh đều 1 048 576:
#   google/gemini-3.7-flash   $0,375 / $1,875   ← mặc định, mới nhất và rẻ nhất trong 3.x
#   google/gemini-3.6-flash   $0,750 / $3,750
#   google/gemini-3.5-flash   $1,500 / $9,000
#   google/gemini-2.5-flash   $0,300 / $2,500   (vào rẻ hơn 20%, ra đắt hơn 33%)
OPENROUTER_MODEL=

# Trần thời gian một lượt gọi VLM, ms. Bỏ trống = 120000. Trần cứng 185000
# (bằng trần `timeoutMs` của /v1/digitize, để hai đường không lệch nhau).
OPENROUTER_TIMEOUT_MS=

# Gán lượt gọi cho app trên bảng xếp hạng OpenRouter. Thuần trang trí, bỏ trống được.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# CHỈ để trỏ vào mock/proxy khi test. Bỏ trống = https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
